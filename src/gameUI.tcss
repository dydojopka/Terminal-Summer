# Цвета имён персонажей
TextBar.dreamgirl{border-title-color: rgb(192,192,192)}   # ...
TextBar.sl{border-title-color: rgb(255,210,0)}            # Славя
TextBar.slp{border-title-color: rgb(255,210,0)}           # Пионерка
TextBar.slg{border-title-color: rgb(255,210,0)}           # Девушка
TextBar.sa{border-title-color: rgb(255,210,0)}            # Саша
TextBar.un{border-title-color: rgb(185,86,255)}           # Лена
TextBar.unp{border-title-color: rgb(185,86,255)}          # Пионерка
TextBar.dv{border-title-color: rgb(255,170,0)}            # Алиса
TextBar.dvp{border-title-color: rgb(255,170,0)}           # Пионерка
TextBar.dvg{border-title-color: rgb(255,170,0)}           # Девушка
TextBar.el{border-title-color: rgb(255,255,0)}            # Электроник
TextBar.elp{border-title-color: rgb(255,255,0)}           # Пионер
TextBar.ro{border-title-color: rgb(255,255,0)}            # Роутер
TextBar.us{border-title-color: rgb(255,50,0)}             # Ульяна
TextBar.usp{border-title-color: rgb(255,50,0)}            # Пионерка
TextBar.usg{border-title-color: rgb(255,50,0)}            # Девушка
TextBar.mt{border-title-color: rgb(0,234,50)}             # Ольга Дмитриевна
TextBar.mtp{border-title-color: rgb(0,234,50)}            # Вожатая
TextBar.mt_voice{border-title-color: rgb(0,234,50)}       # Голос
TextBar.cs{border-title-color: rgb(165,165,255)}          # Виола
TextBar.csp{border-title-color: rgb(165,165,255)}         # Медсестра
TextBar.mz{border-title-color: rgb(114,160,255)}          # Женя
TextBar.mi{border-title-color: rgb(0,252,255)}            # Мику
TextBar.mip{border-title-color: rgb(0,252,255)}           # Пионерка
TextBar.ma{border-title-color: rgb(0,252,255)}            # Маша
TextBar.uv{border-title-color: rgb(78,255,0)}             # Юля
TextBar.uvp{border-title-color: rgb(78,255,0)}            # Странная девочка
TextBar.sh{border-title-color: rgb(255,242,38)}           # Шурик
TextBar.pi{border-title-color: rgb(230,0,0)}              # Пионер
TextBar.me{border-title-color: rgb(225,221,125)}          # Семён
TextBar.my{border-title-color: rgb(225,221,125)}          # Я (эпилог Мику)
TextBar.FIXME_voice{border-title-color: rgb(192,192,192)} # Голос
TextBar.bush{border-title-color: rgb(192,192,192)}        # Голос
TextBar.message{border-title-color: rgb(192,192,192)}     # Сообщение
TextBar.odn{border-title-color: rgb(192,192,192)}         # Одногруппник
TextBar.all{border-title-color: rgb(227,58,58)}           # Пионеры

# Центрирование всего и вся
Screen {
    align: center middle;
    layers: base loading;
}

ScriptStateHeader HeaderIcon {
    display: none;
}

# Консольная прокрутка: одна ячейка, без отдельной фоновой дорожки.
* {
    scrollbar-size: 1 1;
    scrollbar-color: #d8d5c8;
    scrollbar-color-hover: #f3f0df;
    scrollbar-color-active: #e3b778;
    scrollbar-background: transparent;
    scrollbar-background-hover: transparent;
    scrollbar-background-active: transparent;
}

# Одна рамка вокруг всей кнопки; цвет рамки соответствует выделению подписи.
ConsoleButton {
    border: solid #77736a;
    background: transparent;
    color: #d8d5c8;
    text-style: none;
    background-tint: transparent;
    tint: transparent;
}
ConsoleButton:hover {
    border: solid #f3f0df;
}
ConsoleButton.-selected, ConsoleButton.-primary, ConsoleButton.-success,
ConsoleButton.-warning, ConsoleButton.-error {
    border: solid #e3b778;
}
ConsoleButton.danger {
    border: solid #ce8578;
}
ConsoleButton:disabled {
    border: solid #858278;
    color: #858278;
    opacity: 1;
    text-opacity: 1;
}

TerminalSizeWarning { display: none; }
.terminal-too-small {
    layers: base loading terminal-size;
    * { visibility: hidden; }
    TerminalSizeWarning {
        display: block;
        visibility: visible;
        layer: terminal-size;
        position: absolute;
        offset: 0 0;
        width: 100%;
        height: 100%;
        margin: 0;
        padding: 0;
        background: $background;
        content-align: left top;
    }
}

#script-loading {
    layer: loading;
    position: absolute;
    offset: 0 0;
    width: 100%;
    height: 100%;
    padding: 0;
    background: $boost;
    layout: vertical;
    align: center middle;

    LoadingIndicator {
        height: 3;
        width: 34;
    }

    Label {
        width: 34;
        text-align: center;
    }
}

# Окно новеллы
NovelWindow {
    align: center middle;
    # Базовые стили для ASCII-артов
    #bg-cg {
        margin: 0;
        padding: 0;
        column-span: 1;
        content-align: center middle;
    }

    # Окно выбора
    ChoiceBar {
        align-horizontal: center;
        align-vertical: middle;
        width: 100%;
        height: auto;
        max-height: 100%;
        margin: 0 2;

        ListView {
            height: auto;
            max-width: 100%;
            max-height: 100%;
            padding: 0;
            background: transparent;
            background-tint: transparent;
        }

        ListItem, ListItem.-hovered, ListItem.-highlight {
            layout: horizontal;
            margin: 0;
            background: transparent;
            color: #d8d5c8;
            text-style: none;
        }

        Label {
            width: auto;
            max-width: 100%;
            height: auto;
            text-align: center;
            border: none;
        }

        .choice-number {
            padding-right: 1;
            text-align: right;
        }

        Center {
            width: 1fr;
            height: auto;
        }

        ListItem.-hovered Label {
            color: #f3f0df;
            text-style: underline;
        }

        ListItem.-highlight Label {
            color: #e3b778;
            text-style: underline;
        }
    }
}

# Режим новеллы
NovelMenu {
    layout: horizontal;
    dock: bottom;
    margin-bottom: 1;
    padding: 0;

    .novel-control {
        width: 27;
        height: 100%;
    }

    #novel-log-control {
        dock: none;
        align: left bottom;
    }

    #novel-next-control {
        dock: none;
        align: right bottom;
    }

    # Кнопки "Назад" и "Вперёд" 
    #btn-log {
        dock: none;
        margin-left: 10;
        margin-bottom: 1;
        margin-right: 1;
        height: 4;
        min-width: 16;
        width: 16;
    }
    #btn-next{
        dock: none;
        margin-right: 10;
        margin-bottom: 1;
        margin-left: 1;
        height: 4;
        min-width: 16;
        width: 16;
    }
    
    # Нижнее окно с текстом + имя персонажа
    TextBar {
        width: 1fr;
        padding: 0;
        background: $boost;
        min-height: 6;
        border: round white;
        border-title-style: b;
        color: $text;
        height: 6;
        overflow-y: auto;
        .dialogue-content { width: 1fr; height: auto; }
    }
}

# В узком окне убираем декоративные поля вокруг сюжетных кнопок.
.compact-terminal NovelMenu {
    .novel-control { width: 17; }
    #btn-log { margin-left: 0; }
    #btn-next { margin-right: 0; }
}

# Титры занимают только нижнюю панель, оставляя место финальному арту.
Screen.rolling-credits {
    Header { display: none; }
    Footer { display: none; }
}
NovelMenu.credits-mode {
    layout: vertical;
    height: 6;
    max-height: 50%;
    margin-bottom: 0;
    .novel-control { display: none; }
    TextBar {
        width: 100%;
        height: 1fr;
        min-height: 3;
        text-align: center;
        overflow-y: auto;
        .dialogue-content { text-align: center; }
    }
}

# Режим NVL: высокая нижняя панель с обычными элементами управления.
NovelMenu.nvl-mode {
    layout: horizontal;
    dock: bottom;
    height: 99%; # что бы было видно header
    margin-bottom: 1; # что бы было видно footer
    padding: 0;

    TextBar {
        height: 100%;
        min-height: 6;
        background: $boost;
        overflow-y: auto;
    }
}

# Во время выбора скрыта только кнопка продолжения.
NovelMenu.choice-mode {
    #btn-next { visibility: hidden; }
}

# Пауза
PauseMenu {
    align: center middle;

    PauseMenuContainer {
        align: center middle;
        margin-top: 5;
        background: $boost;
        border: round white;
        border-title-align: center;
        border-title-style: b;
        max-width: 40;
        max-height: 25;
    }

    Button {
        margin: 1;
        width: 30;
    }
}

# Меню сохранений
SaveMenu {
    height: 100%;
    border: round white;
    border-title-align: center;
    border-title-style: b;

    SaveMenuLeftBtns {
        width: 14;
        height: 100%;

        #btn-close-save-menu {
            height: 3;
            min-width: 9;
            width: 9;
            margin: 1 0 0 2;
        }

        #container-save-page-btns {
            align: center middle;
            margin: 2 0 2 0;
            Button {
                max-width: 7;
                # width: 1;
                height: 3;
                margin: 0 1;
            }
        }
    }

    SaveMenuMidBtns {
        width: 1fr;
        height: 100%;
        border: outer #CAD06B;
        border-title-align: center;
        border-bottom: none;
        border-right: none;
        border-top: none;

        #save-slots-scroll {
            height: 1fr;
            overflow-x: hidden;
            overflow-y: auto;
        }

        SaveMenuSlots {
            height: auto;

            HorizontalGroup {
                width: 1fr;
                height: auto;
            }

            .save-slot {
                width: 1fr;
                min-width: 0;
                height: 8;
                margin: 1;
                text-align: center;
            }
        }

        SaveMenuActionBtns {
            dock: bottom;
            align: center middle;
            width: 100%;
            height: 5;
            padding: 1 0;

            .save-action-btn {
                width: 1fr;
                min-width: 0;
                max-width: 20;
                height: 3;
                margin: 0 1;
            }
        }
    }
}

# История
LogMenu {
    background: $boost;
    border: dashed gray;
    border-title-align: center;
    border-title-style: b;
    padding: 1 2;

    width: 95%;
    height: 95%;
}

# Как persistent.timeofday в оригинале: палитра общая для ADV/NVL, истории,
# паузы и сюжетных кнопок. Имена персонажей и формы рамок не меняются.
$novel-day: #9dcd55;
$novel-sunset: #dcd168;
$novel-night: #527ba3;
$novel-prologue: #98d8da;

.time-day {
    TextBar, PauseMenuContainer { border: round $novel-day; }
    LogMenu { border: dashed $novel-day; }
    NovelMenu ConsoleButton, PauseMenu ConsoleButton { border: solid $novel-day; }
    ChoiceBar ListItem.-highlight Label { color: $novel-day; }
}
.time-sunset {
    TextBar, PauseMenuContainer { border: round $novel-sunset; }
    LogMenu { border: dashed $novel-sunset; }
    NovelMenu ConsoleButton, PauseMenu ConsoleButton { border: solid $novel-sunset; }
    ChoiceBar ListItem.-highlight Label { color: $novel-sunset; }
}
.time-night {
    TextBar, PauseMenuContainer { border: round $novel-night; }
    LogMenu { border: dashed $novel-night; }
    NovelMenu ConsoleButton, PauseMenu ConsoleButton { border: solid $novel-night; }
    ChoiceBar ListItem.-highlight Label { color: $novel-night; }
}
.time-prologue {
    TextBar, PauseMenuContainer { border: round $novel-prologue; }
    LogMenu { border: dashed $novel-prologue; }
    NovelMenu ConsoleButton, PauseMenu ConsoleButton { border: solid $novel-prologue; }
    ChoiceBar ListItem.-highlight Label { color: $novel-prologue; }
}
# Наведение заметно и в ночной палитре, а выбор остаётся без рамок и заливки.
.time-day ChoiceBar ListItem.-hovered Label,
.time-sunset ChoiceBar ListItem.-hovered Label,
.time-night ChoiceBar ListItem.-hovered Label,
.time-prologue ChoiceBar ListItem.-hovered Label {
    color: #f3f0df;
}

# Настройки
SettingsMenu {
    border: round white;
    border-title-align: center;
    border-title-style: b;
    height: 100%;

    Button {
        width: 17;
    }

    #btn-close-settings {
        height: 3;
        min-width: 9;
        width: 9;
        dock: right;
        margin: 1 3 0 0;
    }

    .setting-with-description {
        padding: 1 0 1 1;
        align: left middle;
        width: 100;
        max-width: 100%;
        height: auto;
        margin: 1;
        border: round white;
        border-title-style: b;
    }

    .setting-controls {
        width: 17;
        height: auto;
        Button { margin: 0; }
    }

    .setting-controls-wide { width: 34; }

    #scene-filter-controls { height: 3; }

    #header-controls .header-setting-row {
        width: 34;
        height: 3;
    }

    #header-content-label {
        width: 34;
        height: 2;
        margin-top: 1;
    }

    .setting-description {
        width: 1fr;
        height: auto;
        margin: 0 1 0 2;
        background: $boost;
    }

    SettingHeader { height: 13; }
    SettingQuality { height: 16; }
    SettingASCIIorANSI { height: 13; }
    SettingTextSpeed { height: 16; }
}

SettingAudio {
    width: 100;
    max-width: 100%;
    height: auto;
    padding: 1;
    margin: 1;
    border: round white;
    border-title-style: b;
}
.audio-setting-row {
    height: 3;
    width: 1fr;
}
.audio-setting-title {
    width: 23;
    content-align: left middle;
    height: 3;
}
.audio-setting-level {
    width: 8;
    content-align: center middle;
    height: 3;
}
.audio-setting-row Button {
    min-width: 8;
    width: 8;
}

# Главное меню
MainMenu {
    height: 100%;
    width: 100%;
    align: center middle;
    overflow: auto auto;


    border: round white;
    border-title-align: center;
    border-title-style: b;

    MainMenuBrand {
        width: 120;
        height: 11;
        align: center middle;
        margin-bottom: 1;
        padding: 0;
        content-align: center middle;
    }

    MainMenuMiddleBtns{
        align: center middle;
        border: tab #AF8D6C;
        border-bottom: hidden;
        border-title-align: center;
        border-title-style: b;
        width: 120;

        Button{
            width: 26;
            margin: 1;
        }
        Label{
            width: 29;
        }
        
        MainMenuStartBtn {
            width: 31;
            height: 30;
            border: ascii #B82D37;
        }
        MainMenuLoadBtn{
            width: 31;
            height: 30;
            border: ascii #B82D37;
            margin-left: 5;
            margin-right: 5;
        }
        MainMenuGalleryBtn {
            width: 31;
            height: 30;
            border: ascii #B82D37;
        }

    }

    MainMenuBottomBtns{
        align: center middle;
        border: thick #AF8D6C;
        border-bottom: hidden;
        width: 120;
        height: 5;

        #btn-achievements {
            dock: left;
            margin-left: 2;
        }
        #btn-settings-menu {
            dock: none;
            width: 25;
        }
        #btn-exit-menu {
            dock: right;
            margin-right: 2;
        }
    }
}

# Галерея
GalleryMenu {
    height: 100%;
    border: round white;
    border-title-align: center;
    border-title-style: b;

    content-align: center middle;

    GalleryMenuLeftBtns {
        width: 22;
        height: 100%;
        
        #container-left-btns {
            align: center middle;
            margin: 3 0 3 0;
            Button {
                width: 20;
                height: 5;
                margin: 1;
            }
        }
    }

    GalleryMenuMidBtns {
        width: 1fr;
        height: 100%;
        border: outer #CAD06B;
        border-title-align: center;
        border-bottom: none;
        border-right: none;

        #bg-cg-gallery {
            overflow: scroll;
        }
        #ansi-content {
            width: auto;
            height: auto;
            text-wrap: nowrap;
        }
    }

    GalleryMenuBottomBtns {
        dock: bottom;
        width: 100%;
        height: 3;
        align: center middle;

        HorizontalGroup {
            width: auto;
            height: 3;
        }

        #gallery-style-controls { margin-left: 2; }

        Button {
            height: 3;
            width: auto;
            min-width: 12;
            padding: 0 1;
            text-wrap: nowrap;
        }

        #btn-back-gallery {
            dock: left;
            min-width: 0;
            width: 10;
        }
        #btn-next-gallery {
            dock: right;
            min-width: 0;
            width: 10;
        }
    }
    
    #btn-close-gallery {
        height: 3;
        min-width: 9;
        width: 9;
        margin: 1 0 0 2;
    }
}

# На минимальной высоте все вкладки остаются видимыми.
GalleryMenuLeftBtns.short-gallery #container-left-btns {
    margin: 1 0;
    Button { height: 3; }
}
.compact-terminal GalleryMenuBottomBtns {
    Button { min-width: 0; }
    #btn-back-gallery, #btn-next-gallery { width: 4; padding: 0; }
    .gallery-quality { padding: 0; }
}

#gallery-art-panel { height: 1fr; }

MusicRoom {
    height: 1fr;
    width: 1fr;
    padding: 0 1;
    overflow-y: auto;
}
#music-search { height: 3; }
#music-help {
    height: auto;
    max-height: 2;
    color: $text-muted;
}
#music-list { height: 1fr; min-height: 1; }
#music-empty { height: auto; }
#music-status { height: 2; }
#music-controls {
    grid-size: 4 2;
    grid-rows: 3;
    height: 6;
    Button { width: 1fr; min-width: 0; height: 3; }
    Label { width: 1fr; height: 3; content-align: center middle; }
}
MusicRow {
    layout: horizontal;
    height: 1;
    padding: 0 1;
    .music-title { width: 1fr; text-overflow: ellipsis; text-wrap: nowrap; }
    .music-duration { width: 6; text-align: right; }
}
MusicRow.music-playing { color: $success; text-style: bold; }

EndingResult {
    align: center middle;
    background: $background 50%;
    #ending-result-panel {
        width: 72;
        max-width: 95%;
        height: 90%;
        max-height: 34;
        border: round white;
        background: $surface;
        padding: 0 1;
        align: center middle;
    }
    #ending-result-heading {
        width: 100%;
        height: 2;
        content-align: center middle;
        text-style: bold;
    }
    #ending-result-content {
        width: 100%;
        height: 1fr;
        min-height: 1;
        align: center top;
    }
    #ending-result-icon { width: 100%; content-align: center middle; }
    Label { width: 100%; height: auto; text-align: center; }
    #ending-result-title { text-style: bold; }
    #ending-result-date { color: $text-muted; }
    #ending-result-actions {
        dock: bottom;
        width: 100%;
        height: 4;
        align: center bottom;
    }
    #btn-ending-menu { width: 24; max-width: 100%; min-width: 0; height: 3; padding: 0 1; }
}

EndingsMenu {
    width: 100%;
    height: 100%;
    border: round white;
    border-title-align: center;
    border-title-style: bold;
    background: $surface;
    padding: 0 1;
}
#endings-toolbar { height: 4; }
#btn-close-endings { width: 12; min-width: 9; }
#endings-progress {
    width: 1fr;
    height: 3;
    content-align: right middle;
}
#endings-help { height: auto; max-height: 2; color: $text-muted; }
#endings-error { height: auto; }
#endings-list { height: 1fr; min-height: 1; background: transparent; }
EndingRow {
    layout: horizontal;
    align: left middle;
    height: auto;
    min-height: 10;
    width: 1fr;
    padding: 1;
    .ending-icon { width: 24; height: 12; margin-right: 2; }
    .ending-details { width: 1fr; height: auto; align: left middle; }
    .ending-route { width: 23; height: auto; margin-right: 2; color: $text-muted; }
    .ending-caption { width: 1fr; height: auto; }
    .ending-title { width: 1fr; height: auto; color: $text-muted; }
    .ending-status { width: 1fr; height: auto; margin-top: 1; color: $text-muted; }
    .ending-date { width: 1fr; height: auto; margin-top: 1; color: $text-muted; }
}
EndingRow.ending-unlocked {
    .ending-route { color: $text; text-style: bold; }
    .ending-title { color: $text; text-style: bold; }
    .ending-status { color: $text; }
}
EndingRow.ending-compact {
    .ending-icon { margin-right: 1; }
    .ending-details { layout: vertical; }
    .ending-route { width: 1fr; margin-right: 0; margin-bottom: 1; }
}

.hidden {
    display: none;
}

OutdatedSaveDialog {
    align: center middle;
    background: $background 80%;
    #outdated-save-panel {
        width: 64;
        max-width: 95%;
        height: auto;
        padding: 1 2;
        background: $surface;
        border: solid gray;
    }
    #outdated-save-title { text-style: bold; margin-bottom: 1; }
    Static { height: auto; margin-bottom: 1; }
    HorizontalGroup { height: auto; width: 100%; }
    Button { width: 1fr; min-width: 10; margin-right: 1; }
}
.invisible {
    visibility: hidden;
}
